{
	"name": "eleventy-base-blog",
	"version": "5.0.2",
	"description": "A starter repository for a blog web site using the Eleventy static site generator.",
	"scripts": {
		"build": "tsx node_modules/@11ty/eleventy/cmd.cjs --config=eleventy.config.ts",
		"watch": "tsx node_modules/@11ty/eleventy/cmd.cjs --config=eleventy.config.ts --watch",
		"serve": "tsx node_modules/@11ty/eleventy/cmd.cjs --config=eleventy.config.ts --serve",
		"start": "tsx node_modules/@11ty/eleventy/cmd.cjs --config=eleventy.config.ts --serve --incremental",
		"debug": "DEBUG=* tsx node_modules/@11ty/eleventy/cmd.cjs --config=eleventy.config.ts",
		"spellcheck": "spellchecker -l en-CA -f **/*.md -d dictionary.txt",
		"spellcheck_dict": "spellchecker -l en-CA -f **/*.md --generate-dictionary"
	},
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git://github.com/11ty/eleventy-base-blog.git"
	},
	"author": {
		"name": "Daniel Goldman",
		"email": "zachleatherman@gmail.com",
		"url": "https://lilatomic.ca/"
	},
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/11ty/eleventy-base-blog/issues"
	},
	"homepage": "https://github.com/11ty/eleventy-base-blog#readme",
	"devDependencies": {
		"@11ty/eleventy": "^3.1.0-beta.1",
		"@11ty/eleventy-navigation": "^0.3.2",
		"@11ty/eleventy-plugin-rss": "^2.0.2",
		"@11ty/eleventy-plugin-syntaxhighlight": "^5.0.0",
		"eleventy-plugin-link_to": "^0.4.0",
		"markdown-it": "^14.1.0",
		"markdown-it-anchor": "^9.2.0",
		"spellchecker-cli": "^6.2.0",
		"tsx": "^4.19.3",
		"data": "file:_data"
	},
	"dependencies": {
		"eleventy-plugin-toc": "^1.1.0",
		"markdown-it-abbr": "^2.0.0",
		"markdown-it-footnote": "^4.0.0",
		"npm": "^10.4.0",
		"jsx-async-runtime": "^1.0.0"
	}
}
