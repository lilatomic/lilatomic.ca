---
pagination:
  data: recipesdb
  size: 1
  alias: recipe
permalink: "recipes/{{ recipe.name | slugify }}.html"
layout: layouts/base.njk
---
<article>
<h1>{{ recipe.name }}</h1>
{% if recipe.original_url %}
<a href="{{ recipe.original_url }}"> recipe source </a>
{% endif %}
<p>
{% if recipe.description %}
{{ recipe.description | safe }}
{% endif %}
</p>

{% recipeTable recipe %}
</article>
